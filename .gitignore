# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# Folders
data/*.csv

# hoopR's full un-trimmed bulk download (~37MB) -- download_nba_data.py's
# local cache of the upstream source so re-runs don't re-hit GitHub's raw
# CDN; data/nba/raw/games.csv (the trimmed, actually-used output) is
# committed, this giant scratch copy is not.
data/nba/raw/nba_schedule_master.csv

# Deployment secrets -- never commit real production env values
deploy/production.env
*.pem

# Local venv / db / logs
football_preds/
webapp/users.db
webapp/analytics.db
webapp/feedback.db
webapp/combo_results.db
webapp/unlocks.db
webapp/degen_test_analytics.db
webapp/degen_test_feedback.db
webapp/sitemap_cache.xml
webapp/sitemap_cache/
webapp/results_cache.html
webapp/mlb_results_cache.html
webapp/nfl_results_cache.html
webapp/nba_results_cache.html
webapp/nhl_results_cache.html
deploy/logs/
deploy/soccer_retrain_state.json
webapp/deposit_config.json
*.log
**/__pycache__/
.pytest_cache/

# Same-shape disk caches as combo_fast/combo_full.pkl above -- admin
# full-markets board and a live-fixtures snapshot, both rebuilt on demand.
webapp/admin_full_markets.pkl
webapp/live_fixtures.pkl
data/daily_digest/
data/live_feeds/
data/admin/
data/telegram_gate.json
output_tables/daily_drafts/

# Combo-picks disk cache -- atomic-write temp files (random suffix) plus the
# stable final names they get renamed to; regenerated on every rebuild,
# never meant to be reusable across machines (same exclusion list sync.sh
# already uses for deploys).
webapp/.combo_*.pkl
webapp/.combo_*.lock
webapp/combo_fast.pkl
webapp/combo_full.pkl

# One-off debugging/deploy scratch scripts (leading underscore) and SSM
# parameter payloads -- disposable, tied to a specific past incident, not
# reusable infra. Real deploy scripts/services/timers are named without
# these prefixes and stay tracked.
deploy/_*
deploy/ssm_*
