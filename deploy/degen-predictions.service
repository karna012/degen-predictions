[Unit]
Description=Degen Predictions Flask app (gunicorn)
After=network.target

[Service]
Type=simple
# Adjust User/WorkingDirectory/paths if you deployed to a different location
# or under a different Linux user than the "ubuntu" default.
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/Degen_predictions/webapp
EnvironmentFile=/home/ubuntu/Degen_predictions/deploy/production.env
ExecStart=/home/ubuntu/Degen_predictions/venv/bin/gunicorn \
    --workers 3 \
    --bind 127.0.0.1:8000 \
    --access-logfile /home/ubuntu/Degen_predictions/gunicorn-access.log \
    --error-logfile /home/ubuntu/Degen_predictions/gunicorn-error.log \
    app:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
