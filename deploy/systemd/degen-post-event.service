[Unit]
Description=Degen Predictions post-event settle (live scores → grade pending)
After=network.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/Degen_predictions/webapp
EnvironmentFile=-/home/ubuntu/Degen_predictions/deploy/production.env
ExecStart=/home/ubuntu/Degen_predictions/venv/bin/python3 /home/ubuntu/Degen_predictions/webapp/post_event_refresh.py
