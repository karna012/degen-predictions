# Copy this file to production.env on the EC2 instance (NOT committed to
# git) and fill in real values. The systemd service reads this file.
#
#   cp deploy/production.env.example deploy/production.env
#   nano deploy/production.env

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-this-with-a-real-random-64-char-hex-string

# Gates /results and any other admin_required() routes behind HTTP Basic
# Auth. If either is left unset, those routes 404 (fails closed, not open).
# When ADMIN_USER is set, FLASK_SECRET_KEY must be a real non-placeholder value.
ADMIN_USER=replace-with-an-admin-username
ADMIN_PASSWORD=replace-with-a-strong-password

# Keep accounts/OAuth off in production until email_verified linking is hardened.
ACCOUNTS_ENABLED=0

# Optional: force Secure session cookies even without ADMIN_USER
# SESSION_COOKIE_SECURE=1

# RapidAPI key for the "UAE Real Estate" API (uae-real-estate3.p.rapidapi.com),
# used by automation/data_fetchers.py's RealEstateDataFetcher to refresh
# /dubai's ROI calculator with real DLD-registered transaction prices.
# Free tier: 750 req/month. If unset, the daily refresh is skipped and the
# calculator keeps using its last cached prices (or static estimates if it
# has never run). Get a key at rapidapi.com -> subscribe to that API's free
# plan -> copy the X-RapidAPI-Key value.
RAPIDAPI_KEY=replace-with-your-rapidapi-key

# ---------------------------------------------------------------------------
# Daily Top-3 digest (degen-daily-distribute.timer @ 03:30 UTC / ~09:00 IST)
# Always writes drafts for admin. Telegram/X do NOT auto-post unless
# CHANNEL_AUTO_POST=1. Send from /admin after you verify.
# See docs/DAILY_DISTRIBUTION.md — never commit real tokens.
# ---------------------------------------------------------------------------

# Public invite for site CTAs (humans join). NOT used as bot chat_id.
TELEGRAM_CHANNEL_URL=https://t.me/+YOUR_INVITE_HASH

# Bot posts when YOU send from /admin (not the morning timer).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Leave unset/0. Set to 1 only if you want the old auto-send behavior.
CHANNEL_AUTO_POST=0

# Optional X / Twitter OAuth1
# TWITTER_API_KEY=
# TWITTER_API_SECRET=
# TWITTER_ACCESS_TOKEN=
# TWITTER_ACCESS_TOKEN_SECRET=

# Optional SMTP email digest
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# DIGEST_EMAIL_TO=

# Optional: slip-image OCR for admin Send to Telegram paste
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# IndexNow (Bing) — key file served at /<key>.txt ; optional override
# INDEXNOW_KEY=84e8fa3329404e81b2aba483549d03f4
# INDEXNOW_ENABLED=1
