# Copy this file to production.env on the EC2 instance (NOT committed to
# git) and fill in real values. The systemd service reads this file.
#
#   cp deploy/production.env.example deploy/production.env
#   nano deploy/production.env

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-this-with-a-real-random-64-char-hex-string

# Gates /results and any other admin_required() routes behind HTTP Basic
# Auth. If either is left unset, those routes 404 (fails closed, not open).
ADMIN_USER=replace-with-an-admin-username
ADMIN_PASSWORD=replace-with-a-strong-password
