{
  "manifest_version": 3,
  "name": "Degen X Poster",
  "version": "1.0.5",
  "description": "Auto-post Degen slips to X right after Telegram send — no X admin page clicks.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Degen X Poster",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "tabs", "scripting", "webNavigation"],
  "host_permissions": [
    "https://degenpredictions.com/*",
    "https://www.degenpredictions.com/*",
    "https://x.com/*",
    "https://twitter.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://degenpredictions.com/admin*",
        "https://www.degenpredictions.com/admin*"
      ],
      "js": ["content/admin.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://x.com/compose/*",
        "https://twitter.com/compose/*"
      ],
      "js": ["content/x.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
